{
  "version": 2,
  "installCommand": "npm install",
  "buildCommand": "npm run build -w @agentos/shared && npm run build -w @agentos/web",
  "outputDirectory": "apps/web/dist",
  "routes": [
    {
      "src": "/assets/(.*)",
      "headers": {
        "cache-control": "public, max-age=31536000, immutable"
      },
      "dest": "/apps/web/dist/assets/$1"
    },
    {
      "handle": "filesystem"
    },
    {
      "src": "/(.*)",
      "dest": "/index.html"
    }
  ]
}
