{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "composite": true,
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "rootDir": ".",
    "outDir": "./dist",
    "tsBuildInfoFile": "./dist/.tsbuildinfo",
    "noEmit": true,
    "types": ["vite/client"],
    "allowSyntheticDefaultImports": true
  },
  "references": [
    { "path": "../../packages/shared" }
  ],
  "include": ["src/**/*", "vite.config.ts"]
}
